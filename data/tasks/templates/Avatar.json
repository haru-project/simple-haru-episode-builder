{
  "app_id": "avatar",
  "episode_id": "1",
  "haru_id": "haru-jp",
  "stage_id": 1,
  "task_id": 1,
  "ready": false,
  "mute": false,
  "teleconference_on": false,
  "description": "Avatar - Request avatar creation from iPads and display results on projector",
  "actions": [
    {
      "action_id": 1,
      "action_type": "HARU_REQUEST",
      "action_content": [
        {
          "user_id": {
            "haru_id": "haru-jp",
            "local_id": -1
          },
          "metainfo": "Request avatars on iPads"
        }
      ],
      "action_arguments": {
        "request_arguments": {
          "request_type": "IMAGE_AVATAR"
        }
      },
      "action_results_key": "avatars",
      "wait_for_action_ids": []
    },
    {
      "action_id": 2,
      "action_type": "HARU_SHARE",
      "action_content": [
        {
          "value": "{video_url}",
          "metainfo": "Avatar Creation Video How to Create from iPads",
          "value_type": "URL_VIDEO"
        }
      ],
      "action_arguments": {
        "share_arguments": {
          "share_mode": "SHOW_SIMPLE",
          "share_type": "VIDEO",
          "share_screen": 1,
          "share_subtype": "APP_CONTENT",
          "share_video_args": {
            "video_loop": true,
            "video_mute": false,
            "video_wait_completion": false
          }
        }
      }
    },
    {
      "action_id": 3,
      "action_type": "HARU_SHARE",
      "action_content": "{{avatars}}",
      "action_arguments": {
        "share_arguments": {
          "share_mode": "SHOW_ALL",
          "share_type": "IMAGE",
          "share_screen": 1,
          "share_subtype": "SHARED_CONTENT",
          "share_image_subtype": "AVATAR"
        }
      },
      "wait_for_action_ids": [1, 2]
    }
  ],
  "template": {
    "parameters": {
      "video_url": {
        "description": "URL or path to the how-to video shown on projector while users create avatars",
        "example": "/shared/projector/resources/AvatarCreation_Howto.webm"
      }
    }
  }
}
